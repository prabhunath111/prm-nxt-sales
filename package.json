{
  "name": "tpSales",
  "version": "0.0.1",
  "private": true,
  "sideEffects": false,
  "scripts": {
    "android": "react-native run-android",
    "android:debug:uat": "node script/build/env.config.js uat && cd android && ./gradlew assembleDebug",
    "android:release:uat": "node script/build/env.config.js uat && cd android && ./gradlew assembleRelease",
    "ios": "react-native run-ios",
    "lint": "yarn lint:ts && yarn lint:style",
    "lint:ts": "tsc --noEmit",
    "lint:style": "eslint \"src/**/*.{ts,tsx}\"",
    "lint:fix": "yarn lint --quiet --fix",
    "prettier": "prettier --check \"src/**/*.{js,jsx,ts,tsx}\"",
    "prettier:fix": "prettier --write \"src/**/*.{js,jsx,ts,tsx}\"",
    "lint:prettier:fix": "yarn prettier:fix && yarn lint:fix",
    "start": "NODE_ENV=development npx react-native start",
    "start:dev": "NODE_ENV=development npx react-native start",
    "start:prod": "NODE_ENV=production npx react-native start",
    "start:clean": "yarn start:dev --resetCache",
    "build:web:dev": "node script/build/env.config.js dev && NODE_ENV=production rm -rf build/ && webpack --mode=production --config script/build/webpack.config.js && cp web/serviceworker.js build/",
    "build:web:uat": "node script/build/env.config.js uat && NODE_ENV=production rm -rf build/ && webpack --mode=production --config script/build/webpack.config.js && cp web/serviceworker.js build/",
    "build:web:stage": "node script/build/env.config.js stage && NODE_ENV=production rm -rf build/ && webpack --mode=production --config script/build/webpack.config.js && cp web/serviceworker.js build/",
    "build:web:prod": "node script/build/env.config.js prod && NODE_ENV=production rm -rf build/ && webpack --mode=production --config script/build/webpack.config.js && cp web/serviceworker.js build/",
    "start:web": "node script/build/env.config.js dev && npm run prebuild && NODE_ENV=development webpack serve --mode=development --config script/build/webpack.config.js",
    "start:web:uat": "node script/build/env.config.js uat && npm run prebuild && NODE_ENV=development webpack serve --mode=development --config script/build/webpack.config.js",
    "start:web:local": "node script/build/env.config.js test && NODE_ENV=test webpack serve --mode=development --config script/build/webpack.config.js",
    "generate": "plop --plopfile script/generators/index.js",
    "test": "TZ=UTC jest --coverage",
    "update-stories": "sb-rn-get-stories --config-path .ondevice",
    "prestart": "yarn update-stories",
    "storybook-watcher": "sb-rn-watcher --config-path .ondevice",
    "storybook": "yarn update-stories & start-storybook -p 6006",
    "build-storybook": "build-storybook",
    "prepare": "npx husky install",
    "docs": "jsdoc -r -c jsdoc.json",
    "docs:start": "node script/doc/serve.js",
    "sonarqube": "sonar-scanner",
    "language": "cd android && ./gradlew clean translateMyString",
    "rnfix": "yarn rnx-align-deps --write",
    "prebuild": "node script/build/mox-script.js"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "yarn lint:prettier:fix"
    ],
    "*.js": "eslint --cache --fix"
  },
